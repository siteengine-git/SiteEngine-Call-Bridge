@@ -0,0 +1,55 @@
+<?php
+defined('ABSPATH') || exit;
+if(!current_user_can(\SiteEngine\CallBridge\Admin\Menu::CAP))return;
+?>
+<div class="wrap">
+<h1>Call Bridge — Setup &amp; Status</h1>
